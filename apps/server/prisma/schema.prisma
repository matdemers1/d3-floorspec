// D3 Floorspec schema (FLR-T-0.4). The shape is foreman://FLR/data_model; this file is the
// relational half of it — the Floorspec document itself lives in `versions.document` as JSONB.
//
// Three rules are enforced by the database rather than trusted to the code, by triggers and checks
// in the migration SQL (Prisma does not model either):
//   1. A version row is immutable and shared by hash: `versions` refuses UPDATE and DELETE, and its
//      key must be a lowercase hex SHA-256.
//   2. `op_log` is append-only: it refuses UPDATE and DELETE.
//   3. `audit_log` is append-only for the same reason.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Accounts and authentication ───────────────────────────────────────────

/// `operator` is the account first-run setup creates: it invites everybody else (FLR-REQ-009).
enum AccountRole {
  operator
  member
}

enum AuthMethod {
  password
  oidc
}

enum ThrottleScope {
  account
  ip
}

model Account {
  id String @id @default(uuid(7)) @db.Uuid

  /// Stored lower-cased; the login lookup lower-cases too.
  email       String      @unique
  displayName String      @map("display_name")
  role        AccountRole @default(member)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  disabledAt DateTime? @map("disabled_at") @db.Timestamptz(6)

  credential       Credential?
  identities       Identity[]
  sessions         Session[]
  projects         Project[]
  invitesSent      Invite[]      @relation("InvitedBy")
  acceptedInvite   Invite?       @relation("AcceptedBy")
  ops              OpLog[]
  tokens           ApiToken[]
  changesetsMade   Changeset[]   @relation("ChangesetCreatedBy")
  changesetsClosed Changeset[]   @relation("ChangesetClosedBy")
  ruleProfiles     RuleProfile[]

  @@map("accounts")
}

model Credential {
  accountId String @id @map("account_id") @db.Uuid

  /// Argon2id over an HMAC of the password with the server's pepper.
  passwordHash      String    @map("password_hash")
  passwordUpdatedAt DateTime  @default(now()) @map("password_updated_at") @db.Timestamptz(6)
  /// Encrypted with the KEK. Null until TOTP enrolment starts.
  totpSecret        String?   @map("totp_secret")
  /// Null until a code proves the enrolment works; TOTP is not in force before then.
  totpConfirmedAt   DateTime? @map("totp_confirmed_at") @db.Timestamptz(6)
  /// Last accepted TOTP step, so a code cannot be replayed inside its window.
  totpLastStep      BigInt?   @map("totp_last_step")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

/// A D3 Auth identity linked to an account. Sign in with D3 Auth resolves through this table and
/// never creates an account (FLR-T-0.5).
model Identity {
  id        String @id @default(uuid(7)) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  iss   String
  sub   String
  /// What the issuer said when the link was made, for display only.
  email String?

  linkedAt    DateTime  @default(now()) @map("linked_at") @db.Timestamptz(6)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([iss, sub])
  /// One identity per issuer per account: a second link from the same issuer replaces nothing.
  @@unique([accountId, iss])
  @@map("identities")
}

model Session {
  id        String @id @default(uuid(7)) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// The cookie carries a random value; only its SHA-256 is stored.
  tokenHash  String     @unique @map("token_hash")
  method     AuthMethod
  ip         String?
  userAgent  String?    @map("user_agent")
  lastSeenAt DateTime   @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime?  @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
  @@map("sessions")
}

/// A single-use, expiring link the operator creates. The only way an account other than the
/// operator comes to exist (FLR-REQ-009): there is no public sign-up route.
model Invite {
  id String @id @default(uuid(7)) @db.Uuid

  tokenHash   String  @unique @map("token_hash")
  /// Optional: when set, the account created from this invite must use this address.
  email       String?
  createdById String  @map("created_by_id") @db.Uuid

  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt        DateTime? @map("accepted_at") @db.Timestamptz(6)
  acceptedAccountId String?   @unique @map("accepted_account_id") @db.Uuid
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdBy       Account  @relation("InvitedBy", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedAccount Account? @relation("AcceptedBy", fields: [acceptedAccountId], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@map("invites")
}

/// Login throttling, per account and per IP, decided before any hash is computed.
model AuthThrottle {
  scope ThrottleScope
  key   String

  failures      Int      @default(0)
  nextAllowedAt DateTime @map("next_allowed_at") @db.Timestamptz(6)
  lastFailureAt DateTime @default(now()) @map("last_failure_at") @db.Timestamptz(6)

  @@id([scope, key])
  @@map("auth_throttle")
}

// ─── Projects and documents ────────────────────────────────────────────────

model Project {
  id             String @id @default(uuid(7)) @db.Uuid
  ownerAccountId String @map("owner_account_id") @db.Uuid
  name           String

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete: the op log and the versions it points at are append-only and stay.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  /// The jurisdiction profile its findings are evaluated under (FLR-T-6.8). Null: the instance's
  /// default — "Model Codes (latest)" (Rules 10.6) unless RULE_PROFILE names another.
  ruleProfileId String? @map("rule_profile_id") @db.Uuid

  owner       Account      @relation(fields: [ownerAccountId], references: [id], onDelete: Restrict)
  ruleProfile RuleProfile? @relation(fields: [ruleProfileId], references: [id], onDelete: SetNull)
  heads       Head[]
  ops         OpLog[]
  tokens      ApiToken[]
  changesets  Changeset[]
  retiredIds  RetiredId[]

  @@index([ownerAccountId])
  @@index([ruleProfileId])
  @@map("projects")
}

/// One canonical Floorspec document, keyed by the lowercase hex SHA-256 of its RFC 8785 (JCS)
/// serialization. Immutable, and shared by every project and op that arrives at the same bytes.
model Version {
  hash     String   @id
  document Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  heads          Head[]
  opsFrom        OpLog[]     @relation("OpBefore")
  opsTo          OpLog[]     @relation("OpAfter")
  changesetBases Changeset[] @relation("ChangesetBase")

  @@map("versions")
}

/// Who wrote an op: a person in a session (`account`), a person's write-scoped API token (`token`),
/// or an agent — an agent-scoped token or Claude's D3 Auth connector (`agent`).
enum AuthorKind {
  account
  agent
  token
}

/// What an op-log row is. `undo` applies the stored inverse of an earlier op and `redo` the inverse
/// of an undo; `merge` is a changeset op arriving on `main` when a person accepts it. History is
/// only ever appended to (FLR-T-2.4).
enum OpKind {
  create
  apply
  undo
  redo
  merge
}

/// Append-only. Every change to a project's document is a batch of Floorspec Ops recorded here
/// (FLR-ADR-008): `seq` counts from 1 per project across every head, and each row moves the head it
/// names from `before_hash` to `after_hash`.
model OpLog {
  id        String @id @default(uuid(7)) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  seq       Int

  kind OpKind @default(apply)
  /// The head this op moved: `main`, or a changeset's scratch head `cs/<changeset id>`.
  head String @default("main")

  authorKind      AuthorKind @map("author_kind")
  /// The person: the session's account, a token's owner, or the account an agent acts for.
  authorAccountId String?    @map("author_account_id") @db.Uuid
  /// Set when an agent did it (its token's name, or the D3 Auth client); agents write changesets,
  /// never main (FLR-ADR-016) — an agent op on main is a `merge` a person accepted.
  authorAgent     String?    @map("author_agent")
  authorTokenId   String?    @map("author_token_id") @db.Uuid

  /// The batch as it was sent, references and all — what a changeset replays.
  ops        Json
  /// The design option the batch was applied in (Ops 0.3, 2.8: `context.option`), replayed with it;
  /// null for an edit of the common design.
  editOption String?  @map("edit_option")
  /// The primitives the applier actually applied, every reference resolved (Ops 1.4).
  resolved   Json?
  /// The batch that turns `after` back into `before` (Ops 1.6); null for the op that created the
  /// project, which has nothing to go back to.
  inverse    Json?
  created    String[] @default([])
  removed    String[] @default([])
  /// Null only for the first op of a project, which creates the document.
  beforeHash String? @map("before_hash")
  afterHash  String  @map("after_hash")

  /// The changeset this op belongs to (on its scratch head), or came from (a `merge` on main).
  changesetId String? @map("changeset_id") @db.Uuid
  /// For `undo` and `redo`: the op whose inverse this applied.
  undoOfId    String? @map("undo_of_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project       Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  authorAccount Account?   @relation(fields: [authorAccountId], references: [id], onDelete: Restrict)
  authorToken   ApiToken?  @relation(fields: [authorTokenId], references: [id], onDelete: Restrict)
  before        Version?   @relation("OpBefore", fields: [beforeHash], references: [hash], onDelete: Restrict)
  after         Version    @relation("OpAfter", fields: [afterHash], references: [hash], onDelete: Restrict)
  changeset     Changeset? @relation(fields: [changesetId], references: [id], onDelete: Restrict)
  undoOf        OpLog?     @relation("UndoOf", fields: [undoOfId], references: [id], onDelete: Restrict)
  undoneBy      OpLog[]    @relation("UndoOf")

  @@unique([projectId, seq])
  @@index([projectId, head, seq])
  @@map("op_log")
}

/// A named pointer into a project's history: `main`, and one scratch head `cs/<id>` per pending
/// changeset (FLR-T-2.5), removed when the changeset is accepted or rejected.
model Head {
  projectId   String @map("project_id") @db.Uuid
  name        String
  versionHash String @map("version_hash")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  version Version @relation(fields: [versionHash], references: [hash], onDelete: Restrict)

  @@id([projectId, name])
  @@map("heads")
}

/// Every element ID a project has ever minted or held, on any head (Ops 1.5): what the applier is
/// handed as `context.retired`, so a deleted wall's ID is never given to a new one. The first head
/// to mint an ID records it; `changeset_id` says which changeset that was, if any.
model RetiredId {
  projectId   String  @map("project_id") @db.Uuid
  elementId   String  @map("element_id")
  changesetId String? @map("changeset_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@id([projectId, elementId])
  @@map("retired_ids")
}

enum ChangesetStatus {
  pending
  accepted
  rejected
}

enum MergeMode {
  fast_forward
  replay
}

/// A named, pending sequence of ops on a scratch head (FLR-ADR-016): what an agent token writes
/// instead of main. A person accepts it — main fast-forwards when it has not moved, otherwise the
/// changeset's batches are replayed onto it — or rejects it, which discards the scratch head.
model Changeset {
  id        String          @id @default(uuid(7)) @db.Uuid
  projectId String          @map("project_id") @db.Uuid
  name      String
  status    ChangesetStatus @default(pending)
  /// Main's head when the changeset was opened: accept fast-forwards only while main is still here.
  baseHash  String          @map("base_hash")

  createdByAccountId String? @map("created_by_account_id") @db.Uuid
  createdByTokenId   String? @map("created_by_token_id") @db.Uuid
  createdByAgent     String? @map("created_by_agent")

  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  closedAt          DateTime?  @map("closed_at") @db.Timestamptz(6)
  closedByAccountId String?    @map("closed_by_account_id") @db.Uuid
  mergeMode         MergeMode? @map("merge_mode")
  mergedHash        String?    @map("merged_hash")

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  base      Version   @relation("ChangesetBase", fields: [baseHash], references: [hash], onDelete: Restrict)
  createdBy Account?  @relation("ChangesetCreatedBy", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  createdByToken ApiToken? @relation(fields: [createdByTokenId], references: [id], onDelete: Restrict)
  closedBy  Account?  @relation("ChangesetClosedBy", fields: [closedByAccountId], references: [id], onDelete: Restrict)
  ops       OpLog[]

  @@index([projectId, status])
  @@map("changesets")
}

enum TokenScope {
  read
  write
  agent
}

/// A per-project API token for the MCP server and the REST API (FLR-T-2.5). Only the SHA-256 of
/// the secret is stored; the secret is shown once. `write` commits to main as the person; `agent`
/// writes named changesets and never main (FLR-ADR-016).
model ApiToken {
  id        String       @id @default(uuid(7)) @db.Uuid
  accountId String       @map("account_id") @db.Uuid
  projectId String       @map("project_id") @db.Uuid
  name      String
  tokenHash String       @unique @map("token_hash")
  /// The first characters of the secret, so a person can tell two tokens apart.
  prefix    String
  scopes    TokenScope[]

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  account    Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  ops        OpLog[]
  changesets Changeset[]

  @@index([accountId])
  @@index([projectId])
  @@map("api_tokens")
}

// ─── Code rules ────────────────────────────────────────────────────────────

/// A jurisdiction profile an account built (Floorspec Rules 0.1, chapter 10; FLR-T-6.8,
/// FLR-REQ-100): the code editions in force where a house is built, from when, and the cited local
/// amendments that withdraw rules. `profile` is the standard's own JSON object, in canonical form,
/// checked by @floorspec/rules-engine before it is stored; nothing here copies a code's text.
/// Deleting one puts the projects that used it back on the default.
model RuleProfile {
  id             String @id @default(uuid(7)) @db.Uuid
  ownerAccountId String @map("owner_account_id") @db.Uuid
  profile        Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner    Account   @relation(fields: [ownerAccountId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([ownerAccountId])
  @@map("rule_profiles")
}

// ─── Audit ─────────────────────────────────────────────────────────────────

/// Append-only. Every mutating route writes one row, in the same transaction as its change.
model AuditLog {
  id String @id @default(uuid(7)) @db.Uuid

  /// `account:<id>`, `token:<id>`, `agent:<token id or client>` or `anonymous`.
  actor          String
  actorAccountId String?  @map("actor_account_id") @db.Uuid
  /// What happened, dotted: `project.create`, `auth.login`, `invite.revoke`.
  action         String
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id")
  at             DateTime @default(now()) @db.Timestamptz(6)
  detail         Json?

  @@index([targetType, targetId])
  @@index([actorAccountId, at])
  @@index([at])
  @@map("audit_log")
}
