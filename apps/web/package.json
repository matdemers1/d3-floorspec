{
  "name": "@d3-floorspec/web",
  "private": true,
  "version": "0.1.0",
  "description": "The D3 Floorspec editor on @d3cloud/ui, served as statics by the API",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . && d3-check-usage src",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "e2e": "vite build && playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@d3cloud/ui": "https://github.com/matdemers1/d3-design-system/releases/download/v1.5.0/d3cloud-ui-1.5.0.tgz",
    "@floorspec/assistant-electrical": "workspace:*",
    "@floorspec/engine": "workspace:*",
    "@floorspec/mesh": "workspace:*",
    "@floorspec/ops": "workspace:*",
    "@floorspec/package": "workspace:*",
    "@floorspec/render2d": "workspace:*",
    "@floorspec/rules-engine": "workspace:*",
    "@react-three/fiber": "9.8.1",
    "lucide-react": "^1.44.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "4.13.0",
    "pg": "8.23.0",
    "vite": "^8.3.0"
  }
}
