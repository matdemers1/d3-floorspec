  "name": "example",
  "rules": {
    "ROOM-SIZE": {
      "applies": {
        "to": "room",
        "where": {
          "measure": "roomFunction",
          "op": "=",
          "value": "sleeping"
        }
      },
      "citation": {
        "code": "TEST-CODE",
        "edition": "2024",
        "link": "https://example.org/test-code/2024/1.2",
        "section": "§1.2"
      },
      "extras": {
        "packFormat": {
          "certification": "original-paraphrase-v1",
          "certifiedBy": "Floorspec contributors",
          "method": "synthetic",
          "review": "reviewed",
          "reviewScope": "The paraphrase, the threshold of 100 square feet and both fixtures."
        }
      },
      "paraphrase": "Every room used for sleeping needs at least 100 square feet of floor, measured inside the finished wall faces. The rule reads the net area Floorspec derives for the room; it does not look at closets or alcoves separately.",
      "provenance": {
        "edition": "2024",
        "reviewed": {
          "by": "Example Reviewer (synthetic)",
          "credential": "Licensed architect (synthetic example)",
          "on": "2026-10-05"
        },
        "verifiedBy": "Floorspec contributors",
        "verifiedOn": "2026-10-05"
      },
      "requirement": {
        "measure": "roomNetArea",
        "op": ">=",
        "value": 15221234073600
      },
      "severity": "mayNotMeet",
      "title": "Sleeping rooms have a minimum floor area"
    },
    "SMOKE-ALARM": {
      "applies": {
        "to": "room",
        "where": {
          "measure": "roomFunction",
          "op": "=",
          "value": "sleeping"
        }
      },
      "citation": {
        "code": "TEST-ELEC",
        "edition": "2026",
        "link": "https://example.org/test-elec/2026/3.1",
        "section": "§3.1"
      },
      "extras": {
        "packFormat": {
          "certification": "original-paraphrase-v1",
          "certifiedBy": "Floorspec contributors",
          "method": "synthetic",
          "review": "unreviewed"
        }
      },
      "paraphrase": "Each room used for sleeping needs at least one alarm that detects smoke inside it. The rule counts FS_electrical alarms whose detects list includes smoke; it does not check where on the ceiling the alarm sits or how alarms are interconnected.",
      "provenance": {
        "edition": "2026",
        "verifiedBy": "Floorspec contributors",
        "verifiedOn": "2026-10-05"
      },
      "requirement": {
        "args": {
          "collection": "alarms",
          "extension": "FS_electrical",
          "match": {
            "detects": "smoke"
          }
        },
        "measure": "elementCount",
        "op": ">=",
        "value": 1
      },
      "severity": "mayNotMeet",
      "title": "A smoke alarm in every sleeping room"
    },
    "STAIR-RISER": {
      "applies": {
        "to": "stair"
      },
      "citation": {
        "code": "TEST-CODE",
        "edition": "2024",
        "link": "https://example.org/test-code/2024/4.1",
        "section": "§4.1"
      },
      "extras": {
        "packFormat": {
          "certification": "original-paraphrase-v1",
          "certifiedBy": "Floorspec contributors",
          "method": "synthetic",
          "review": "unreviewed"
        }
      },
      "paraphrase": "Each step of a stair rises no more than 7 inches from the one below. The rule reads the riser height Floorspec Core derives for the stair: its rise, from the floor at its foot to the floor at its head, over its riser count.",
      "provenance": {
        "edition": "2024",
        "verifiedBy": "Floorspec contributors",
        "verifiedOn": "2026-10-05"
      },
      "requirement": {
        "measure": "stairRiserHeight",
        "op": "<=",
        "value": 227584
      },
      "severity": "mayNotMeet",
      "title": "Stair risers are not too tall"
    }
  },
  "title": "Example pack (synthetic codes)",
  "version": "0.1.0"
}
