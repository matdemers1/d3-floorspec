{
  "name": "d3-floorspec",
  "private": true,
  "version": "0.0.0",
  "description": "D3 Floorspec — the reference implementation of the Floorspec house-as-code standard: engine, editor, API, MCP server, workers and CLI",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=22.13.0", "pnpm": ">=10" },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:python": "cd workers/ifc && .venv/bin/python -m pytest -q",
    "conformance": "pnpm --filter @floorspec/engine conformance"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "turbo": "^2.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
