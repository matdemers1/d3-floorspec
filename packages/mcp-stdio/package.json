{
  "name": "@floorspec/mcp-stdio",
  "private": true,
  "version": "0.1.0",
  "description": "Local stdio shim that speaks MCP to a D3 Floorspec server.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./dist/floorspec-mcp.js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.build.json && vitest run",
    "plugin": "tsc -p tsconfig.build.json && cp dist/floorspec-mcp.js ../../plugin/bin/floorspec-mcp.mjs"
  },
  "bin": {
    "floorspec-mcp": "./dist/floorspec-mcp.js"
  }
}
