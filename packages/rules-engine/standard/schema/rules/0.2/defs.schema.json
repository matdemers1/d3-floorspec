{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d3cloud.io/floorspec/schema/rules/0.2/defs.schema.json",
  "$comment": "Normative (FLR-ADR-006): the definitions the Floorspec Rules 0.2 schemas share.",
  "title": "Floorspec Rules 0.2 shared definitions",
  "$defs": {
    "floorspecRules": {
      "title": "Floorspec Rules draft",
      "description": "The draft of Floorspec Rules an object targets: \"0.2\".",
      "const": "0.2"
    },
    "id": {
      "title": "ID",
      "description": "Core 3.1.1: an element ID; also a rule ID (2.1).",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "packName": {
      "title": "Pack name",
      "description": "2.1: lowercase words of letters and digits joined by hyphens, 1–64 characters.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "title": "Version",
      "description": "2.1: Semantic Versioning 2.0.0, <major>.<minor>.<patch> with an optional -prerelease, as a registry entry (Core 12.2).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
    },
    "range": {
      "title": "Version range",
      "description": "10.4: a version range in the grammar of Core 12.3.",
      "type": "string",
      "pattern": "^(>=|>|<=|<|=|\\^|~)?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?( +(>=|>|<=|<|=|\\^|~)?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?)*( +\\|\\| +(>=|>|<=|<|=|\\^|~)?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?( +(>=|>|<=|<|=|\\^|~)?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?)*)*$"
    },
    "extensionName": {
      "title": "Extension name",
      "description": "Core 1.6.1.",
      "type": "string",
      "pattern": "^(FS|EXT|[A-Z0-9]{2,8})_[A-Za-z0-9]+$"
    },
    "collectionName": {
      "title": "Collection name",
      "description": "Core 12.5.",
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$"
    },
    "code": {
      "title": "Code",
      "description": "3.2: the short name of a code: IRC, NEC, IPC, IMC, IFGC.",
      "type": "string",
      "maxLength": 32,
      "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$"
    },
    "edition": {
      "title": "Edition",
      "description": "3.2: an edition, usually its year.",
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.-]{0,15}$"
    },
    "section": {
      "title": "Section",
      "description": "3.2: the section as the code numbers it: 1–64 characters, no control character, neither beginning nor ending with a space.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u0020\\u007f-\\u009f](?:[^\\u0000-\\u001f\\u007f-\\u009f]*[^\\u0000-\\u0020\\u007f-\\u009f])?$"
    },
    "date": {
      "title": "Date",
      "description": "0.3: a calendar date, YYYY-MM-DD.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "httpsUri": {
      "title": "https URI",
      "description": "An absolute https URI with an authority, as Core 8.6.",
      "type": "string",
      "format": "uri",
      "pattern": "^https://(?:[A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=-]|%[0-9A-Fa-f]{2})+$"
    },
    "title": {
      "title": "Title",
      "description": "A short name, 1–200 characters.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "text": {
      "title": "Text",
      "description": "Prose, 1–2000 characters.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "citation": {
      "title": "Citation",
      "description": "3.2: the code, edition and section a rule checks, and optionally a link to the section in the publisher's free public viewer. A reference, never a quotation.",
      "type": "object",
      "required": [
        "code",
        "edition",
        "section"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "edition": {
          "$ref": "#/$defs/edition"
        },
        "section": {
          "$ref": "#/$defs/section"
        },
        "link": {
          "$ref": "#/$defs/httpsUri"
        }
      },
      "additionalProperties": false
    },
    "integer": {
      "title": "Integer",
      "description": "A JSON integer within ±(2^53 − 1).",
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "test": {
      "title": "Test",
      "description": "3.8: a condition, or all, any or not of tests.",
      "oneOf": [
        {
          "$ref": "#/$defs/condition"
        },
        {
          "title": "All",
          "description": "3.8: holds when every test holds.",
          "type": "object",
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/test"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "title": "Any",
          "description": "3.8: holds when some test holds.",
          "type": "object",
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/test"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "title": "Not",
          "description": "3.8: holds when the test does not.",
          "type": "object",
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/test"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "condition": {
      "title": "Condition",
      "description": "3.8: a measure (chapters 5–8), computed on the target with args, compared with value by op. Whether the measure, args, op and value fit together is typing (3.9), not the schema.",
      "type": "object",
      "required": [
        "measure",
        "op",
        "value"
      ],
      "properties": {
        "measure": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "args": {
          "type": "object"
        },
        "op": {
          "type": "string",
          "enum": [
            "<",
            "<=",
            "=",
            "!=",
            ">=",
            ">",
            "in",
            "has"
          ]
        },
        "value": {
          "oneOf": [
            {
              "$ref": "#/$defs/integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "purpose": {
      "title": "Purpose",
      "description": "Core 13.5: why a clearance envelope is kept clear.",
      "type": "string",
      "enum": [
        "workingSpace",
        "fixtureClearance",
        "swing",
        "access"
      ]
    },
    "severity": {
      "title": "Finding severity",
      "description": "3.11: how a finding reads. Never an error; never blocking.",
      "type": "string",
      "enum": [
        "mayNotMeet",
        "check",
        "note"
      ]
    },
    "coverageEntry": {
      "title": "Coverage entry",
      "description": "2.4: a section of a code a pack addresses in full, in part, or not at all.",
      "type": "object",
      "required": [
        "code",
        "edition",
        "section",
        "status"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "edition": {
          "$ref": "#/$defs/edition"
        },
        "section": {
          "$ref": "#/$defs/section"
        },
        "status": {
          "type": "string",
          "enum": [
            "addressed",
            "partial",
            "notAddressed"
          ]
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      },
      "additionalProperties": false
    }
  }
}
