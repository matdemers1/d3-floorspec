{
  "name": "@floorspec/package",
  "private": true,
  "version": "0.1.0",
  "description": "The .floorspec package: a Floorspec document and its assets as one deterministic ZIP or an identical folder, read back with zip-slip, size and entry limits. Isomorphic.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p test",
    "test": "vitest run"
  },
  "dependencies": {
    "@floorspec/engine": "workspace:*",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@floorspec/ops": "workspace:*"
  }
}
