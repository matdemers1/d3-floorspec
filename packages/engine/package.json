{
  "name": "@floorspec/engine",
  "private": true,
  "version": "0.1.0",
  "description": "Isomorphic Floorspec engine: validate, canonicalize, derive (walls, rooms, areas). No Node-only APIs (FLR-ADR-010).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p test && tsc -p scripts",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "conformance": "vitest run --project node test/conformance.node.test.ts",
    "sync-standard": "tsx scripts/sync-standard.ts",
    "generate": "tsx scripts/generate.ts",
    "check:generated": "tsx scripts/generate.ts --check"
  },
  "devDependencies": {
    "@vitest/browser": "5.0.2",
    "@vitest/browser-playwright": "5.0.2",
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2",
    "json-schema-to-typescript": "^16.0.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15"
  }
}
