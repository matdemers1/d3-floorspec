          },
          "description": "Outlets: an ID → element map (Core 12.5)."
        },
        "doorbells": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/doorbell"
