      "properties": {
        "speaker": {
          "description": "What it is.",
          "type": "string",
          "enum": [
            "inCeiling",
            "inWall",
            "surface",
            "subwoofer",
            "volumeControl"
          ]
        },
        "zone": {
          "description": "An audio zone label.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "headEnd": {
          "description": "3.1: the head-end it is run to.",
          "$ref": "#/$defs/id"
        },
        "fallback": {
          "description": "Core 12.6: checked by Core, not here."
        },
        "host": {
