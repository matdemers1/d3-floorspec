            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/headEnd"
          },
          "description": "Head-ends: an ID → element map (Core 12.5)."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
