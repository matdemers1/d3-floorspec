            "siren",
            "camera"
          ]
        },
        "zone": {
          "description": "A zone label.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "wireless": {
          "description": "True when it is not run to a head-end by wire.",
          "type": "boolean",
          "default": false
        },
        "headEnd": {
          "description": "3.1: the head-end it is run to.",
          "$ref": "#/$defs/id"
