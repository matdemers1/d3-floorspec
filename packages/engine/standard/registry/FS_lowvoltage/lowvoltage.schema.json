              "data",
              "coax",
              "phone",
              "fiber"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "ports": {
          "description": "Ports of each medium.",
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 1
