{
  "name": "@floorspec/cli",
  "private": true,
  "version": "0.1.0",
  "description": "The floorspec command line: validate, canonicalize, hash, derive and migrate Floorspec documents, and write and unpack .floorspec packages.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.build.json && vitest run"
  },
  "bin": {
    "floorspec": "./dist/bin.js"
  },
  "dependencies": {
    "@floorspec/engine": "workspace:*",
    "@floorspec/migrate": "workspace:*",
    "@floorspec/package": "workspace:*"
  }
}
