# D3 Floorspec — copy to .env for local development
DATABASE_URL=postgres://floorspec:floorspec@localhost:5432/floorspec
PUBLIC_URL=http://localhost:5173
SESSION_SECRET=change-me
ASSET_DIR=./data/assets
# Sign in with D3 Auth (optional)
D3AUTH_ISSUER=https://auth.d3cloud.io
D3AUTH_CLIENT_ID=
D3AUTH_CLIENT_SECRET=
# Alerts via the D3 Auth mail relay
ALERT_RELAY_URL=
ALERT_EMAIL=
