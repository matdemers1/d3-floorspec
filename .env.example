# D3 Floorspec — copy to .env for local development (`pnpm --filter @d3-floorspec/server dev`).
PUBLIC_URL=http://localhost:5173
DATABASE_URL=postgresql://floorspec:floorspec@127.0.0.1:55440/floorspec_dev
# Both: openssl rand -base64 32. The api refuses to start with these placeholders.
KEK=change-me
PEPPER=change-me
PORT=3400
# Sign in with D3 Auth (optional — all three, or none). Redirect URI to register:
# <PUBLIC_URL>/auth/oidc/callback; scopes requested: openid profile email d3:roles.
D3AUTH_ISSUER=
D3AUTH_CLIENT_ID=
D3AUTH_CLIENT_SECRET=
# Rule packs (optional): a directory of built Floorspec Rules 0.1 packs — each *.json file, or each
# <name>/generated/pack.json (the standard's rules/ folder after `pnpm packs`) — read and validated
# at boot. Unset: no pack, and findings say so. RULE_PROFILE: a profile file to evaluate them under;
# unset, the default profile (model codes, latest editions).
RULE_PACKS_DIR=
RULE_PROFILE=

# Who drains the job queue (PDF and DXF exports): `worker` (the worker container — the production
# default) or `inline` (this api process — the default anywhere else, where no worker runs).
JOB_DRAIN=
