# D3 Floorspec — copy to .env for local development (`pnpm --filter @d3-floorspec/server dev`).
PUBLIC_URL=http://localhost:5173
DATABASE_URL=postgresql://floorspec:floorspec@127.0.0.1:55440/floorspec_dev
# Both: openssl rand -base64 32. The api refuses to start with these placeholders.
KEK=change-me
PEPPER=change-me
PORT=3400
# Sign in with D3 Auth (optional — all three, or none). Redirect URI to register:
# <PUBLIC_URL>/auth/oidc/callback; scopes requested: openid profile email d3:roles.
D3AUTH_ISSUER=
D3AUTH_CLIENT_ID=
D3AUTH_CLIENT_SECRET=
